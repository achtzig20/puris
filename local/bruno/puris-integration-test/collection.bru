script:pre-request {
  const customerProfileVersion = bru.getEnvVar("CUSTOMER_POLICY_PROFILE_VERSION");
  const supplierProfileVersion = bru.getEnvVar("SUPPLIER_POLICY_PROFILE_VERSION");
  const POLICY_VERSION_2405 = "profile2405";
  const POLICY_VERSION_2509 = "profile2509";
  const POLICY_NAMESPACE_2405 = "https://w3id.org/catenax/policy/";
  const POLICY_NAMESPACE_2509 = "https://w3id.org/catenax/2025/9/policy/";
  const POLICY_OPERATOR_2405 = "eq";
  const POLICY_OPERATOR_2509 = "isAnyOf";
  const POLICY_ACTION_2405 = "odrl:use";
  const POLICY_ACTION_2509 = "cx-policy:access";
  
  if (customerProfileVersion === POLICY_VERSION_2405) {
    bru.setVar("CUSTOMER_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
    bru.setVar("CUSTOMER_POLICY_OPERATOR", POLICY_OPERATOR_2405)
    bru.setVar("CUSTOMER_POLICY_ACTION", POLICY_ACTION_2405)
    if (supplierProfileVersion === POLICY_VERSION_2405) {
      bru.setVar("CUSTOMER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_ACTION", POLICY_ACTION_2405)
    } else {
      bru.setVar("CUSTOMER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_NAMESPACE", POLICY_NAMESPACE_2509)
      bru.setVar("SUPPLIER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_OPERATOR", POLICY_OPERATOR_2509)
      bru.setVar("SUPPLIER_POLICY_ACTION", POLICY_ACTION_2509)
    }
    bru.setVar("CUSTOMER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
  } else {
    bru.setVar("CUSTOMER_POLICY_NAMESPACE", POLICY_NAMESPACE_2509)
    bru.setVar("CUSTOMER_POLICY_OPERATOR", POLICY_OPERATOR_2509)
    bru.setVar("CUSTOMER_POLICY_ACTION", POLICY_ACTION_2509)
    if (supplierProfileVersion === POLICY_VERSION_2405) {
      bru.setVar("CUSTOMER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2405)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_OPERATOR", POLICY_OPERATOR_2405)
      bru.setVar("SUPPLIER_POLICY_ACTION", POLICY_ACTION_2405)
    } else {
      bru.setVar("CUSTOMER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2509)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2509)
      bru.setVar("CUSTOMER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2509)
      bru.setVar("SUPPLIER_POLICY_NAMESPACE", POLICY_NAMESPACE_2509)
      bru.setVar("SUPPLIER_COUNTERPARTY_PROFILE_VERSION", POLICY_VERSION_2509)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_NAMESPACE", POLICY_NAMESPACE_2509)
      bru.setVar("SUPPLIER_COUNTERPARTY_POLICY_OPERATOR", POLICY_OPERATOR_2509)
      bru.setVar("SUPPLIER_POLICY_OPERATOR", POLICY_OPERATOR_2509)
      bru.setVar("SUPPLIER_POLICY_ACTION", POLICY_ACTION_2509)
    }
  }

}
