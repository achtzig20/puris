meta {
  name: Get Reported Material Stocks from Supplier
  type: http
  seq: 2
}

get {
  url: {{CUSTOMER_PURIS_BACKEND}}/catena/stocks/material/reported?ownMaterialNumber={{SEMICONDUCTOR_MATERIAL_NUMBER_CUSTOMER}}
  body: none
  auth: none
}

headers {
  X-Api-Key: {{CUSTOMER_PURIS_BACKEND_API_KEY}}
}

tests {
  test("response is ok", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("contains reported stock from supplier", function() {
    const stocks = res.getBody();
    const supplierStock = stocks.find(s => s.partner && s.partner.bpnl === bru.getEnvVar("SUPPLIER_BPNL"));
    expect(supplierStock).to.exist;
    expect(supplierStock.stockQuantity).to.be.above(0);
  });
}
