meta {
  name: Trigger Tier2 Send Notification
  type: http
  seq: 1
}

post {
  url: {{TIER2_MOCK}}/api/mock/send-notification
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  console.log("Send-notification response:", JSON.stringify(body, null, 2));
  if (body && body.notificationId) {
    bru.setVar("TIER2_SENT_NOTIFICATION_ID", body.notificationId);
    console.log("Notification ID:", body.notificationId);
  }
}

tests {
  test("response is ok", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("notification sent successfully", function() {
    expect(res.getBody().status).to.equal("sent");
  });

  test("notificationId present", function() {
    expect(res.getBody().notificationId).to.exist;
  });
}
