meta {
  name: Supplier EDC Catalog for Tier2
  type: http
  seq: 5
}

post {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/catalog/request
  body: json
  auth: none
}

headers {
  X-Api-Key: {{SUPPLIER_EDC_API_KEY}}
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "@type": "CatalogRequest",
    "protocol": "dataspace-protocol-http",
    "counterPartyAddress": "{{TIER2_MOCK_INT}}/api/v1/dsp",
    "counterPartyId": "{{TIER2_BPNL}}",
    "querySpec": {
      "offset": 0,
      "limit": 100,
      "filterExpression": []
    }
  }
}

tests {
  test("response is ok", function() {
    expect(res.getStatus()).to.equal(200);
  });

  const datasets = res.getBody()["dcat:dataset"];

  test("Supplier EDC can see tier2 catalog", function() {
    expect(datasets).to.be.an("array");
    expect(datasets.length).to.be.above(0);
  });

  test("DTR asset visible via Supplier EDC", function() {
    const dtr = datasets.find(d =>
      d["dct:type"] && d["dct:type"]["@id"] &&
      d["dct:type"]["@id"].includes("DigitalTwinRegistry")
    );
    expect(dtr).to.exist;
  });
}
