    "policyProfileVersion": "{{SUPPLIER_POLICY_PROFILE_VERSION}}",
    "addresses": [],
    "sites": [
      {
        "bpns": "{{TIER2_BPNS}}",
        "name": "Tier2 Supplier Inc. Production Site",
        "addresses": [
          {
            "bpna": "{{TIER2_BPNA}}",
            "streetAndNumber": "Main Street 1",
            "zipCodeAndCity": "20001 Hamburg",
            "country": "Germany"
          }
        ]
      }
    ]
  }
}

tests {
