meta {
  name: Get Negotiation State
  type: http
  seq: 3
}

get {
  url: {{SUPPLIER_EDC}}/{{MANAGEMENT_PATH}}/v3/contractnegotiations/{{TIER2_NEGOTIATION_ID}}
  body: none
  auth: none
}

headers {
  X-Api-Key: {{SUPPLIER_EDC_API_KEY}}
}

script:pre-request {
  console.log("⏳ Waiting for negotiation to finalize (5s)...");
  await new Promise(resolve => setTimeout(resolve, 5000));
  console.log("✓ Wait complete, fetching negotiation state...");
}

script:post-response {
  const jsonData = res.getBody();
  // Try different field name conventions: state, edc:state, dspace:state
  const state = jsonData.state || jsonData["edc:state"] || jsonData["dspace:state"];
  console.log("\n========== NEGOTIATION STATE DEBUG ==========");
  console.log("Current State:", state);
  console.log("Full Response:", JSON.stringify(jsonData, null, 2));

  // Try different field names: contractAgreementId, edc:contractAgreementId, dspace:contractAgreementId
  const agreementId = jsonData.contractAgreementId || 
                      jsonData["edc:contractAgreementId"] || 
                      jsonData["dspace:contractAgreementId"];
  console.log("contractAgreementId:", agreementId);
  
  if (state !== "FINALIZED" && state !== "dspace:FINALIZED") {
    console.warn("⚠️  NEGOTIATION NOT FINALIZED YET! State:", state);
    console.warn("Need to wait longer or check for errors");
  }
  
  bru.setVar("TIER2_CONTRACT_AGREEMENT_ID", agreementId);
  console.log("===========================================\n");
}

tests {
  test("response is ok", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("negotiation finalized", function() {
    const body = res.getBody();
    const state = body.state || body["edc:state"] || body["dspace:state"];
    if (state !== "FINALIZED" && state !== "dspace:FINALIZED") {
      console.error("❌ State is " + state + ", expected FINALIZED or dspace:FINALIZED");
    }
    expect(state).to.be.oneOf(["FINALIZED", "dspace:FINALIZED"]);
  });

  test("contract agreement ID present", function() {
    const body = res.getBody();
    const agreementId = body.contractAgreementId || 
                       body["edc:contractAgreementId"] || 
                       body["dspace:contractAgreementId"];
    expect(agreementId).to.exist;
  });
}
